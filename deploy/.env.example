# Copy to deploy/.env. Never commit the copy.

# Jev (required): https://typesafe.ai
TYPESAFE_API_KEY=

# Claude Haiku words the sentence under each answer. Leave empty and built-in sentences are used instead.
ANTHROPIC_API_KEY=

# Cloudflare Turnstile, the "are you human" check on upload. Both, or neither (neither = no check: local use only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Public hostname -> http://app:8787
TUNNEL_TOKEN=

# Where "Source" on the page points. The commit is filled in at build time.
SOURCE_URL=https://github.com/flxbl-io/sf-audit-ask

# Optional: count attempts in Redis (Upstash REST) instead of this process's memory. One box does not need it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits
ATTEMPTS=5
ATTEMPT_WINDOW_HOURS=24
JEV_IN_FLIGHT=8
